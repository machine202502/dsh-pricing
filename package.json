{
  "name": "dsh-pricing",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "DeepSeek peak hours, live token prices and the session's actual spend in the session header, for the official provider.",
  "license": "MIT",
  "author": "machine202502",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/machine202502/dsh-pricing.git"
  },
  "homepage": "https://github.com/machine202502/dsh-pricing#readme",
  "bugs": {
    "url": "https://github.com/machine202502/dsh-pricing/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "data/*.json",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
